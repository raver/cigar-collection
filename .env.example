# Database Password (used in docker-compose.yml to construct DATABASE_URL)
DB_PASSWORD=your_secure_password_here

# Full DATABASE_URL (for local development - override when running locally)
# In Docker, DATABASE_URL is automatically constructed from DB_PASSWORD
DATABASE_URL=postgresql://cigar:your_secure_password_here@localhost:5432/cigar

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=cigar-images
R2_PUBLIC_URL=https://img.yourdomain.com

# Admin
ADMIN_USERNAME=admin
# 生成方法: node -e "console.log(require('bcryptjs').hashSync('你的密码', 10))"
ADMIN_PASSWORD_HASH=$2a$10$...
SESSION_SECRET=a-random-32-char-string

# API
API_PORT=3001
